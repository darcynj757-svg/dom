modules = ["nodejs-20", "web", "bash", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["pnpm", "--filter", "@workspace/api-server...", "--filter", "@workspace/stroy-doma...", "--if-present", "run", "build"]
run = ["pnpm", "--filter", "@workspace/api-server", "run", "start"]

[[deployment.rewrites]]
from = "/about"
to = "/about/index.html"

[[deployment.rewrites]]
from = "/services"
to = "/services/index.html"

[[deployment.rewrites]]
from = "/services/*"
to = "/services/*/index.html"

[[deployment.rewrites]]
from = "/production"
to = "/production/index.html"

[[deployment.rewrites]]
from = "/production/*"
to = "/production/*/index.html"

[[deployment.rewrites]]
from = "/projects"
to = "/projects/index.html"

[[deployment.rewrites]]
from = "/projects/*"
to = "/projects/*/index.html"

[[deployment.rewrites]]
from = "/articles"
to = "/articles/index.html"

[[deployment.rewrites]]
from = "/articles/*"
to = "/articles/*/index.html"

[[deployment.rewrites]]
from = "/gallery"
to = "/gallery/index.html"

[[deployment.rewrites]]
from = "/contacts"
to = "/contacts/index.html"

[[deployment.rewrites]]
from = "/terms"
to = "/terms/index.html"

[[deployment.rewrites]]
from = "/uslugi"
to = "/uslugi/index.html"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/stroy-doma: web"

[[workflows.workflow]]
name = "artifacts/stroy-doma: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=19912 BASE_PATH=/ pnpm --filter @workspace/stroy-doma run dev"
waitForPort = 19912

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19912
externalPort = 80

[userenv]

[userenv.shared]
PORT = "3000"
